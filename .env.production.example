# On the selected server, prepare-deployment.sh creates private .env and fills canonical paths.
COMPOSE_PROJECT_NAME=reef
REEF_IMAGE=registry.gitlab.renaudbaivier.com/reef/reef
APP_VERSION=v0.9.0
REEF_INSTALLATION_DIR=/CANONICAL/ABSOLUTE/PATH/reef
REEF_PROJECT_ROOT=/CANONICAL/ABSOLUTE/PATH
# Same host-port convention as Flix; no public proxy route is configured.
REEF_LISTEN_ADDRESS=0.0.0.0
REEF_PORT=8099
# Existing Docker network shared with the deploy runner. No webhook host port.
REEF_CI_NETWORK=proxy
# Supply independent private values; never commit the completed file.
DEPLOY_TOKEN=
REGISTRY_URL=registry.gitlab.renaudbaivier.com
REGISTRY_USER=
REGISTRY_PASSWORD=
